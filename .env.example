# Banco
MONGO_URI=mongodb://127.0.0.1:27017/novaauditoria

# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# JWT
JWT_SECRET=troque-este-segredo-em-producao
JWT_EXPIRES=7d

# Bootstrap super admin (criado automaticamente se não existir)
BOOTSTRAP_ADMIN_EMAIL=admin@novaauditoria.local
BOOTSTRAP_ADMIN_PASSWORD=admin123
BOOTSTRAP_ADMIN_NAME=Administrador

# Upload
UPLOAD_MAX_MB=100

# WhatsApp — reabrir no boot as sessões já pareadas.
# Deixe false numa segunda instância que use a mesma pasta backend/sessions/:
# dois sockets na mesma sessão se derrubam (erro 440).
WHATSAPP_RESTAURAR_SESSOES=true
